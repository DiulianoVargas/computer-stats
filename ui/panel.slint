// The Panel (002/003 contracts/ui.md): two Views switched by tabs; Esc closes it.
import { Theme } from "theme.slint";
import { MetricsView, MetricRowData, DriveRowData } from "metrics-view.slint";
import { ProcessesView, AppRowData } from "processes-view.slint";

export { MetricRowData, DriveRowData, AppRowData }
// The Desktop Widget is compiled from this entry file too (005 research R8).
export { WidgetWindow } from "widget.slint";

component Tab inherits VerticalLayout {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    spacing: 3px;

    Text {
        text: root.text;
        color: root.active ? Theme.text : Theme.muted-text;
        font-weight: root.active ? 600 : 400;

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }

    Rectangle {
        height: 2px;
        border-radius: 1px;
        background: root.active ? Theme.accent-bar : transparent;
    }
}

export component PanelWindow inherits Window {
    // Metrics View
    in property <MetricRowData> cpu-usage;
    in property <MetricRowData> cpu-temperature;
    in property <MetricRowData> gpu-usage;
    in property <MetricRowData> gpu-temperature;
    in property <MetricRowData> gpu-fan;
    in property <MetricRowData> vram;
    in property <MetricRowData> memory-usage;
    in property <[MetricRowData]> fans;
    in property <string> fans-reason;
    in property <[DriveRowData]> drives;

    // Processes View
    in property <[AppRowData]> apps;
    in property <int> sort;
    in property <bool> apps-loading: true;
    out property <bool> apps-hovered: processes.list-hovered;

    // 0 Metrics View, 1 Processes View.
    in-out property <int> view;

    // Esc pressed; the app hides the Panel.
    callback close-requested();
    callback view-changed(int);
    callback sort-clicked(int);
    callback end-clicked(string);
    callback background-clicked();
    // The Panel's height changed (View switch, Drives added or removed): the app re-anchors it.
    callback panel-height-changed();

    changed panel-height => {
        root.panel-height-changed();
    }

    property <length> tabs-height: 22px;
    // The Processes View's Panel height is fixed (contracts/ui.md).
    property <length> processes-height: 460px;

    // Logical height the Panel needs, so the app can position it before showing it.
    out property <length> panel-height: view == 1 ? processes-height : min(content.preferred-height, 640px);

    title: "Computer Stats";
    no-frame: true;
    always-on-top: true;
    width: 320px;
    height: panel-height;
    background: Theme.background;
    default-font-size: Theme.font-size;
    forward-focus: keys;

    function switch-to(v: int) {
        if (root.view != v) {
            root.view = v;
            root.view-changed(v);
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            if (event.text == Key.Tab && event.modifiers.control) {
                root.switch-to(root.view == 0 ? 1 : 0);
                return accept;
            }
            reject
        }

        Rectangle {
            border-width: 1px;
            border-color: Theme.border;

            // Clicks that reach the background cancel an armed End.
            TouchArea {
                clicked => {
                    root.background-clicked();
                }
            }

            content := VerticalLayout {
                padding: Theme.padding;
                spacing: Theme.section-gap;

                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    height: root.tabs-height;

                    Tab {
                        text: "Metrics";
                        active: root.view == 0;
                        clicked => {
                            root.switch-to(0);
                        }
                    }
                    Tab {
                        text: "Processes";
                        active: root.view == 1;
                        clicked => {
                            root.switch-to(1);
                        }
                    }
                }

                // Both Views always exist, so the Panel's height is right the moment the View
                // changes; only the shown one takes space.
                VerticalLayout {
                    spacing: 0;

                    MetricsView {
                        visible: root.view == 0;
                        height: root.view == 0 ? self.preferred-height : 0px;
                        cpu-usage: root.cpu-usage;
                        cpu-temperature: root.cpu-temperature;
                        gpu-usage: root.gpu-usage;
                        gpu-temperature: root.gpu-temperature;
                        gpu-fan: root.gpu-fan;
                        vram: root.vram;
                        memory-usage: root.memory-usage;
                        fans: root.fans;
                        fans-reason: root.fans-reason;
                        drives: root.drives;
                    }

                    processes := ProcessesView {
                        visible: root.view == 1;
                        // The rest of the fixed-height Panel; nothing while hidden.
                        height: root.view == 1 ? root.processes-height - 2 * Theme.padding - root.tabs-height - Theme.section-gap : 0px;
                        apps: root.apps;
                        sort: root.sort;
                        loading: root.apps-loading;
                        sort-clicked(column) => {
                            root.sort-clicked(column);
                        }
                        end-clicked(key) => {
                            root.end-clicked(key);
                        }
                        background-clicked => {
                            root.background-clicked();
                        }
                    }
                }
            }
        }
    }
}
