// Color and spacing tokens (research R12). Light/dark follow the Windows app theme.
import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    out property <brush> background: dark ? #202020 : #f9f9f9;
    out property <brush> border: dark ? #3a3a3a : #e0e0e0;
    out property <brush> text: dark ? #ffffff : #1b1b1b;
    out property <brush> muted-text: dark ? #a0a0a0 : #616161;
    out property <brush> section-text: dark ? #c8c8c8 : #424242;
    out property <brush> accent-bar: dark ? #60cdff : #005fb8;
    out property <brush> bar-track: dark ? #3d3d3d : #e5e5e5;

    out property <length> padding: 16px;
    out property <length> section-gap: 12px;
    out property <length> row-gap: 4px;
    out property <length> font-size: 13px;
    out property <length> section-font-size: 12px;
}
